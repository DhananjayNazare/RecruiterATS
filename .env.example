# Production configuration
ARS_ENV=production
ARS_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
PORT=5001
ARS_RUN_BACKGROUND_WORKERS=1
# Secure cookies: keep 1 with HTTPS (ARS_SSL=1). Use 0 only if you set ARS_SSL=0 and use plain HTTP.
ARS_SESSION_COOKIE_SECURE=1
# --- HTTPS / SSL certificate ---
ARS_SSL=1
# Leave these empty to use an auto-created self-signed certificate (stored in certs/).
# For a trusted certificate (Let's Encrypt, company CA, mkcert) set the PEM file paths:
# ARS_SSL_CERT=C:\\certs\\fullchain.pem
# ARS_SSL_KEY=C:\\certs\\privkey.pem
# Extra names/IPs for the self-signed certificate (machine name, localhost and LAN IPs are added automatically):
# ARS_SSL_HOSTS=ats.mycompany.local,192.168.1.20
# --- AI ---
# OpenAI cloud:
# OPENAI_API_KEY=your-key
# OPENAI_MODEL=gpt-5-mini
# Local Ollama (or any OpenAI-compatible server). The key is optional unless your server/proxy requires one:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=your-secret-key
# OPENAI_MODEL=llama3.1          # must be pulled: ollama pull llama3.1
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-user
# SMTP_PASSWORD=your-password
# SMTP_USE_TLS=1
# Public address candidates use to open meeting links in interview emails (or set it in Settings)
# ARS_BASE_URL=https://ats.yourcompany.com

# Hidden backend super user (not shown in the Admin panel; the only account that can see/change SMTP settings).
# Created automatically on first start. If ARS_SUPERUSER_PASSWORD is empty, a random one is printed once in the server console.
ARS_SUPERUSER_EMAIL=superuser@ars.local
ARS_SUPERUSER_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
